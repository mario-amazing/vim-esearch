Include: helper.vader

" nvim-tree.lua is neovim only and is loaded from ~/.cache/esearch-dev/plugins,
" see spec/support/viml/vader.vim
Execute(setup):
  let g:nvimtree_available = has('nvim') && luaeval("pcall(require, 'nvim-tree')")
  if g:nvimtree_available
    lua require('nvim-tree').setup({})
  endif

Before:
  Save g:esearch
  let g:esearch.cwd = 'spec/fixtures/filemanager_nvimtree'.g:test_number.next().'/'
  let g:file1 = 'dir1/file1.txt'
  let g:file2 = 'file2.txt'
  let g:file3 = 'dir1/file3.txt'
  call esearch#stderr#incremental('workaround to avoid vader bug', ['with autoload fail'])
  tabnew
After:
  Restore g:esearch
  if g:nvimtree_available | silent! NvimTreeClose | endif

Execute(nvim-tree: dir under the cursor):
  if g:nvimtree_available
    exe 'bwipe!' Fixture(g:esearch.cwd.g:file1, ['1.l1'])
    exe 'bwipe!' Fixture(g:esearch.cwd.g:file2, ['2.l1'])
    exe 'NvimTreeOpen' g:esearch.cwd
    exe "norm /dir1\<CR>\<plug>(esearch).\<CR>"
    AssertEqual getline(1, '$'), [
        \ 'Matches in 1 line, 1 file. Finished.',
        \ '',
        \ 'dir1/file1.txt',
        \ '   1 1.l1',
        \]
  endif

Execute(nvim-tree: file under the cursor searches in its dir):
  if g:nvimtree_available
    exe 'bwipe!' Fixture(g:esearch.cwd.g:file1, ['1.l1'])
    exe 'bwipe!' Fixture(g:esearch.cwd.g:file3, ['3.l1'])
    exe 'bwipe!' Fixture(g:esearch.cwd.g:file2, ['2.l1'])
    exe 'NvimTreeOpen' g:esearch.cwd
    exe "norm /dir1\<CR>\<CR>/file1\<CR>\<plug>(esearch).\<CR>"
    AssertEqual getline(1, '$'), [
        \ 'Matches in 2 lines, 2 files. Finished.',
        \ '',
        \ 'dir1/file1.txt',
        \ '   1 1.l1',
        \ '',
        \ 'dir1/file3.txt',
        \ '   1 3.l1',
        \]
  endif

Execute(nvim-tree: root line searches in the whole tree):
  if g:nvimtree_available
    exe 'bwipe!' Fixture(g:esearch.cwd.g:file1, ['1.l1'])
    exe 'bwipe!' Fixture(g:esearch.cwd.g:file2, ['2.l1'])
    exe 'NvimTreeOpen' g:esearch.cwd
    exe "norm gg\<plug>(esearch).\<CR>"
    AssertEqual getline(1, '$'), [
        \ 'Matches in 2 lines, 2 files. Finished.',
        \ '',
        \ 'dir1/file1.txt',
        \ '   1 1.l1',
        \ '',
        \ 'file2.txt',
        \ '   1 2.l1',
        \]
  endif

Execute(nvim-tree: marked nodes win over the node under the cursor):
  if g:nvimtree_available
    exe 'bwipe!' Fixture(g:esearch.cwd.g:file1, ['1.l1'])
    exe 'bwipe!' Fixture(g:esearch.cwd.g:file3, ['3.l1'])
    exe 'bwipe!' Fixture(g:esearch.cwd.g:file2, ['2.l1'])
    exe 'NvimTreeOpen' g:esearch.cwd
    exe "norm /dir1\<CR>\<CR>/file3\<CR>"
    lua require('nvim-tree.api').marks.toggle()
    exe "norm /file2\<CR>"
    lua require('nvim-tree.api').marks.toggle()
    exe "norm /file1\<CR>\<plug>(esearch).\<CR>"
    AssertEqual getline(1, '$'), [
        \ 'Matches in 2 lines, 2 files. Finished.',
        \ '',
        \ 'dir1/file3.txt',
        \ '   1 3.l1',
        \ '',
        \ 'file2.txt',
        \ '   1 2.l1',
        \]
    lua require('nvim-tree.api').marks.clear()
  endif
